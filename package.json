{
  "name": "cyber-cube-timer",
  "private": true,
  "version": "3.0.0",
  "description": "Esports-style speedcubing timer — WCA random-state scrambles, 3D preview, stats, CPU battle. Runs fully in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@preact/signals": "2.11.2",
    "cubing": "0.63.7",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@preact/preset-vite": "2.10.6",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2",
    "workbox-window": "7.4.1"
  }
}
